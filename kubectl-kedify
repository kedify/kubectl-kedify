#!/bin/bash
set -e

kedify::__resolve_script_path() {
    local candidate="${1:-$0}"
    local resolved=""
    local target=""
    local candidate_dir=""

    if [[ "$candidate" != */* ]]; then
        resolved=$(command -v -- "$candidate" 2>/dev/null || true)
        if [[ -n "$resolved" ]]; then
            candidate="$resolved"
        fi
    fi

    while [[ -L "$candidate" ]]; do
        if ! command -v readlink >/dev/null 2>&1; then
            break
        fi

        target=$(readlink "$candidate" 2>/dev/null || true)
        if [[ -z "$target" ]]; then
            break
        fi

        if [[ "$target" == /* ]]; then
            candidate="$target"
        else
            candidate_dir="$(cd "$(dirname "$candidate")" && pwd)"
            candidate="${candidate_dir}/${target}"
        fi
    done

    printf '%s\n' "$candidate"
}

SCRIPT_PATH="$(kedify::__resolve_script_path "$0")"
DIR="${DIR:-$( cd "$( dirname "${SCRIPT_PATH}" )" && pwd )}"
AUTOSCALABLE_RESOURCE_KINDS=(ingress service virtualservice httproute)
AUTOSCALABLE_RESOURCE_KIND=""
TEMPLATE_FILE=${TEMPLATE_FILE:-"hso.yaml"}
export COL="\e[2;35;49m"
export RES="\e[0m"
HELPERS="${DIR}/preview-functions.sh"
DEBUG_SCRIPT="${DIR}/debug.sh"
INSIGHTS_SCRIPT="${DIR}/insights.sh"
DUMP_SCRIPT="${DIR}/dump.sh"
MC_SCRIPT="${DIR}/multicluster.sh"
VERSION_FILE="${DIR}/VERSION"
README_FILE="${DIR}/README.md"

kedify::__has_yes_flag() {
    local arg=""
    for arg in "$@"; do
        if [[ "$arg" == "-y" || "$arg" == "--yes" ]]; then
            return 0
        fi
    done
    return 1
}

kedify::__read_single_char() {
    if [[ -n "${ZSH_VERSION:-}" ]]; then
        IFS= read -r -k 1 REPLY
    else
        IFS= read -r -n 1 REPLY
    fi
}

# Source debug script if it exists
if [[ -f "${DEBUG_SCRIPT}" ]]; then
    # shellcheck source=./debug.sh
    source "${DEBUG_SCRIPT}"
else
    echo "Warning: Debug script not found at ${DEBUG_SCRIPT}" >&2
fi

# Source insights script if it exists
if [[ -f "${INSIGHTS_SCRIPT}" ]]; then
    # shellcheck source=./insights.sh
    source "${INSIGHTS_SCRIPT}"
else
    echo "Warning: Insights script not found at ${INSIGHTS_SCRIPT}" >&2
fi

# Source multicluster script if it exists
if [[ -f "${MC_SCRIPT}" ]]; then
    # shellcheck source=./multicluster.sh
    source "${MC_SCRIPT}"
else
    echo "Warning: Multicluster script not found at ${MC_SCRIPT}" >&2
fi

# Source dump script if it exists
if [[ -f "${DUMP_SCRIPT}" ]]; then
    # shellcheck source=./dump.sh
    source "${DUMP_SCRIPT}"
else
    echo "Warning: Dump script not found at ${DUMP_SCRIPT}" >&2
fi

main() {
    local c=""
    local requirements=""

    [[ $# -lt 1 ]] && print_usage && exit 1
    for c in curl figlet fzf kubectl yq jq; do
        if ! command -v "${c}" &> /dev/null; then
            if [[ -r "${README_FILE}" ]]; then
                requirements=$(grep -A99 '### Requirements' "${README_FILE}" || true)
            fi
            echo -e "Install ${c}, this script needs it.\n       ^^^^^^\n\n\n${requirements}"
            exit 2
        fi
    done
    # bat is special on ubuntu
    command -v "bat" &> /dev/null || command -v "batcat" &> /dev/null || echo -e "Install bat this script needs it.\n\n  consult https://github.com/sharkdp/bat?tab=readme-ov-file#installation"
    BAT=$(command -v "bat" &> /dev/null && echo "bat" || echo "batcat")
    KUBECTL=$(command -v "kubecolor" &> /dev/null && echo "kubecolor" || echo "kubectl")
    export BAT
    export KUBECTL

    case "${1}" in
        delete|d)
            delete "$@"
            ;;
        status|s)
            status
            ;;
        logs|l)
            shift 1
            logs "$@"
            ;;
        autoscale|a)
            case "${2:-}" in
                ingress|ing|i)
                    AUTOSCALABLE_RESOURCE_KIND="ingress"
                    autoscale_ing
                    ;;
                *)
                    autoscale
                    ;;
            esac
            ;;
        multicluster|mc)
            shift 1
            multicluster::cmd "$@"
            ;;
        debug|dbg)
            shift 1
            debug::cmd "$@"
            ;;
        insights|ins)
            shift 1
            insights::cmd "$@"
            ;;
        dump|dmp)
            shift 1
            dump::cmd "$@"
            ;;
        -v|--version)
            print_version
            ;;
        -h|--help)
            print_usage
            ;;
        *)
            print_usage
            ;;
    esac
}

autoscale() {
    AUTOSCALABLE_RESOURCE_KIND=$(printf "%s\n" "${AUTOSCALABLE_RESOURCE_KINDS[@]}" | \
     tr ' ' '\n' | \
     fzf --header "Select a kind that represents the applications you would like to autoscale based on incoming http traffic" --prompt='λ' --cycle --preview-window top:80% \
      --preview "printf '${COL}'; figlet -f big Kedify.io;printf '${RES}'; echo Kind: {}; kubectl get {} -A")
    [[ ${AUTOSCALABLE_RESOURCE_KIND} == "ingress" ]] && {
        autoscale_ing
    }
}

autoscale_ing() {
    AUTOSCALABLE_RESOURCE_AND_NS=$(kubectl get "${AUTOSCALABLE_RESOURCE_KIND}" --no-headers -o custom-columns=":metadata.namespace,:metadata.name" -A | \
    fzf --header "Select ${AUTOSCALABLE_RESOURCE_KIND} that represents the applications you would like to autoscale based on incoming http traffic" --prompt='λ' --cycle --preview-window top:80% \
      --preview "source ${HELPERS} && printf '${COL}'; figlet -f big Kedify.io;printf '${RES}'; preview_ing {} ${AUTOSCALABLE_RESOURCE_KIND};")
    AUTOSCALABLE_RESOURCE=$(echo "${AUTOSCALABLE_RESOURCE_AND_NS}" | awk '{ print $2}')
    NS=$(echo "${AUTOSCALABLE_RESOURCE_AND_NS}" | awk '{ print $1}')
    export AUTOSCALABLE_RESOURCE
    export NS

    export HSO_NAME=${AUTOSCALABLE_RESOURCE}
    HSO_HOST=$(kubectl get -n "${NS}" "${AUTOSCALABLE_RESOURCE_KIND}" "${AUTOSCALABLE_RESOURCE}" -ojson | jq -r '.spec.rules[0].host')
    HSO_SVC=$(kubectl get -n "${NS}" "${AUTOSCALABLE_RESOURCE_KIND}" "${AUTOSCALABLE_RESOURCE}" -ojson | jq -r '.spec.rules[0].http.paths[0].backend.service.name')
    HSO_PORT=$(kubectl get -n "${NS}" "${AUTOSCALABLE_RESOURCE_KIND}" "${AUTOSCALABLE_RESOURCE}" -ojson | jq -r '.spec.rules[0].http.paths[0].backend.service.port.number')
    export HSO_HOST
    export HSO_SVC
    export HSO_PORT
    ask_for_details
    check_result "${TEMPLATE_FILE}" "${AUTOSCALABLE_RESOURCE_KIND}" "${AUTOSCALABLE_RESOURCE}"
}

ask_for_details() {
    MAX=$(for x in {0..20}; do echo "$x"; done | fzf --prompt='λ' --cycle --header "Max number of replicas?")
    export MAX
}

check_result() {
    [[ $# -lt 3 ]] && echo "usage: $0 <file_path> <kind> <resource>" && exit 1
    local file_path="$1"
    envsubst < "${file_path}" | "${BAT}" -lyaml --file-name="hso.yaml"
    printf "Are you sure to create the HTTPScaledObject for %s %s on cluster %s'%s'%s\nHit 'e' for modifying the manifest further.\nHit 'p' for printing the manifests to stdout." \
        "$2" "$3" "$COL" "$(kubectl config current-context)" "$RES"
    echo "[y/N/e/p]?"
    kedify::__read_single_char
    _resp="${REPLY}"
    [[ $_resp =~ [yY] ]] && {
        # here we apply the manifests
        envsubst < "${file_path}" | kubectl apply -f -
    }
    [[ $_resp =~ [eE] ]] && {
        tmp="$(mktemp).yaml"
        envsubst < "${file_path}" > "${tmp}"
        "${EDITOR}" "${tmp}"
        check_result "${tmp}" "${2}" "${3}"
    }
    [[ $_resp =~ [pP] ]] && {
        envsubst < "${file_path}"
    }
    exit 0
}

status() {
    clear
    figlet kedify status
    echo -e "\nKedify:\n------"
    "${KUBECTL}" get kedifyconfigurations kedify -owide -nkeda
    echo -e "\n\nDetailed status\n---------------"
    "${KUBECTL}" get kedifyconfigurations kedify -nkeda -oyaml | yq '.status'
    echo -e "\n\nPods running in namespace 'keda'\n--------------------------------"
    "${KUBECTL}" get pods -nkeda
    "${KUBECTL}" tree --version &> /dev/null && {
        echo -e "\n\nKedify deployments\n------------------"
        "${KUBECTL}" tree kedifyconfigurations.install.kedify.io kedify -n keda
    }
}

logs() {
    figlet logs
    "${KUBECTL}" logs -lcontrol-plane=kedify-agent -nkeda --tail=-1 "$@"
}

insights() {
    # Delegate to insights module
    insights::cmd "$@"
}

delete() {
    if [[ $- == *i* ]] || kedify::__has_yes_flag "$@"; then
        _resp="y"
    else # ask only if shell is interactive or -y was passed
        printf "Do you want to uninstall Kedify on cluster %s'%s'%s\n" \
            "$COL" "$(kubectl config current-context)" "$RES"
        echo "[y/N]?"
        kedify::__read_single_char
        _resp="${REPLY}"
    fi
    [[ $_resp =~ [yY] ]] && {
        echo -e "\nDeleting Kedify.."
        "${KUBECTL}" delete kedifyconfigurations kedify -nkeda
    }
}

print_usage() {
    cat << EOF

Usage: kubectl kedify (d)elete | (s)tatus | (a)utoscale | (mc)multicluster | (dbg)debug | (ins)ights | (dmp)dump | -h|--help

Available commands:
   delete,       d     Uninstalls the Kedify agent
   logs,         l     Prints the logs of Kedify agent
   status,       s     Prints the status of Kedify agent
   autoscale,    a     Runs the interactive mode for creating HTTPScaledObject
   multicluster, mc    Manages multicluster configuration (e.g., setup-member for registering member clusters)
   debug,        dbg   Provides low level information regarding Kedify components
   insights,     ins   Analyzes ScaledObjects for potential configuration issues
   dump,         dmp   Collects comprehensive debug information from Kedify/KEDA components

   --version,    -v    Prints the version
   --help,       -h    Shows this help message

Examples:
   kubectl kedify d -y                            ... deletes the Kedify agent w/o asking
   kubectl kedify autoscale                       ... will ask questions
   kubectl kedify autoscale ingress               ... will ask questions about what ingress to autoscale
   kubectl kedify l -f                            ... prints the logs of Kedify agent and follows them
   kubectl kedify a ing                           ... same as ^
   kubectl kedify insights                        ... analyzes ScaledObjects in current namespace
   kubectl kedify ins -A                          ... analyzes ScaledObjects in all namespaces
   kubectl kedify insights -n myapp               ... analyzes ScaledObjects in specific namespace
   kubectl kedify dump                            ... collects debug info from current namespace
   kubectl kedify dmp -A --archive                ... collects debug info from all namespaces as tar.gz
   kubectl kedify dump -o /tmp/debug -n myapp     ... collects debug info from specific namespace

EOF
}

print_version() {
  if [[ -r "${VERSION_FILE}" ]]; then
      cat "${VERSION_FILE}"
  else
      echo "unknown"
  fi
  echo ""
  echo "Latest released versions:"
  echo " - kubectl-kedify: $(curl -sL "https://api.github.com/repos/kedify/kubectl-kedify/releases/latest" | jq -r '.tag_name')"
  curl -sL "https://kedify.github.io/charts/index.yaml" | \
      yq -r '.entries | to_entries | .[] | " - " + .key + ": " + ( .value | sort_by(.created) | .[-1] | .version )' | \
      grep -v 'external-scaler-azure-cosmos-db'
}

cleanup() {
    exit 0
}
trap cleanup EXIT 1 2 3 6

main "$@"
